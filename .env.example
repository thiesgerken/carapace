# Required
ANTHROPIC_API_KEY=sk-ant-...
CARAPACE_TOKEN=pick-a-bootstrap-admin-password
# Shared by the server and the skill builder, e.g. from `openssl rand -hex 20`
CARAPACE_BUILDER_TOKEN=pick-a-random-builder-token

# Dev stack only (process-compose, docs/development.md): 0 for the main checkout, 1 to 9 for worktrees
# CARAPACE_DEV_STACK=0

# Optional — LLM providers
# GOOGLE_API_KEY=
# OPENROUTER_API_KEY=

# Optional — Matrix channel
# CARAPACE_MATRIX_PASSWORD=

# Optional — Git remote token
# CARAPACE_GIT_TOKEN=

# Optional — Bitwarden sidecar (start with: docker compose up -d --scale bw=1)
# Empty BW_SERVER_URL → sidecar applies US cloud once; cached on container disk until URL changes or container is recreated.
# BW_SERVER_URL=https://vault.bitwarden.eu
# BW_EMAIL=you@example.com
# BW_CLIENTID=user.xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# BW_CLIENTSECRET=xxxxxxxxxxxxxxxxxxxx
# BW_MASTER_PASSWORD=

# Optional — internal destinations skills may reach through the sandbox proxy (JSON lists).
# The proxy refuses private and internal addresses otherwise; each domain still needs approval.
# CARAPACE_SANDBOX_PROXY_ALLOWED_NETWORKS=["192.168.178.0/24"]
# CARAPACE_SANDBOX_PROXY_ALLOWED_HOSTS=["paperless.home.arpa"]

# Docker socket GID (auto-detected on most systems)
# DOCKER_GID=0

#!/usr/bin/env python3
"""cgate: ask Carapace up front for what a command will need.

Usage:
    cgate request [--domain D]... [--credential VAULT_PATH]... [--oauth VAULT_PATH]... [--tunnel HOST:PORT]...
                  [--store-path PATH]

Exit status: 0 approved, 1 denied or failed (the reason is on stderr), 2 usage error.
The contract is documented in docs/sandbox.md; generated skill wrappers depend on it.
"""

from __future__ import annotations

import argparse
import base64
import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request


def _api() -> tuple[str, str | None]:
    """Return (base_url, auth_header) from CARAPACE_API_URL, which embeds the session credentials."""
    raw = os.environ.get("CARAPACE_API_URL")
    if not raw:
        print("error: CARAPACE_API_URL not set", file=sys.stderr)
        sys.exit(1)
    parsed = urllib.parse.urlparse(raw)
    if parsed.username and parsed.hostname:
        creds = base64.b64encode(f"{parsed.username}:{parsed.password or ''}".encode()).decode()
        clean = parsed._replace(netloc=parsed.hostname + (f":{parsed.port}" if parsed.port else ""))
        return clean.geturl().rstrip("/"), f"Basic {creds}"
    return raw.rstrip("/"), None


def cmd_request(args: argparse.Namespace) -> None:
    base_url, auth_header = _api()
    body = {
        "domains": args.domain,
        "credentials": args.credential,
        "oauth": args.oauth,
        "tunnels": args.tunnel,
        "store_path": args.store_path,
    }
    req = urllib.request.Request(
        f"{base_url}/gate",
        data=json.dumps(body).encode(),
        headers={"Content-Type": "application/json"},
        method="POST",
    )
    if auth_header:
        req.add_header("Authorization", auth_header)
    try:
        with urllib.request.urlopen(req):
            pass
    except urllib.error.HTTPError as e:
        # 403 is a denial by the sentinel or the user, 400/404 a bad request, 502 a tunnel that did not open;
        # their body says why.
        message = e.read().decode() if e.code in (400, 403, 404, 502) else f"{e.code} {e.reason}"
        print(f"error: {message}", file=sys.stderr)
        sys.exit(1)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="cgate",
        description="Ask Carapace up front for the domains and credentials a command needs.",
        epilog=(
            "examples:\n"
            "  cgate request --domain api.example.com --credential personal/api-key\n"
            "  cgate request --domain '*.example.com' --store-path /nix/store/...-my-skill\n"
            "  cgate request --tunnel imap.example.com:993\n"
            "\n"
            "One sentinel decision covers everything requested. After approval the domains are\n"
            "reachable, and `ccred get` returns the credentials (`ccred get --access-token` the OAuth\n"
            "access tokens) without another review, until the exec ends. A tunnel is open when cgate\n"
            "returns: connect to HOST:PORT by its name as usual. Anything requested later\n"
            "in the same exec is reviewed as a follow-up.\n"
            "Exit status: 0 approved, 1 denied or failed (reason on stderr), 2 usage error."
        ),
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = parser.add_subparsers(dest="command", required=True)
    request = sub.add_parser("request", help="Request domains and credentials for the running exec")
    request.add_argument("--domain", action="append", default=[], help="Domain or *.domain (repeatable)")
    request.add_argument("--credential", action="append", default=[], help="Vault path (repeatable)")
    request.add_argument(
        "--oauth", action="append", default=[], help="OAuth vault path, for its access token (repeatable)"
    )
    request.add_argument(
        "--tunnel", action="append", default=[], help="HOST:PORT for a client that does not speak HTTP (repeatable)"
    )
    request.add_argument("--store-path", help="The calling wrapper's own Nix store path")

    args = parser.parse_args(args=None if sys.argv[1:] else ["--help"])
    if not args.domain and not args.credential and not args.oauth and not args.tunnel:
        request.error("nothing requested: give at least one --domain, --credential, --oauth or --tunnel")
    cmd_request(args)


if __name__ == "__main__":
    main()
